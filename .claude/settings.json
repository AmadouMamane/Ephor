{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run lint-imports *)",
      "Bash(uv run mutmut *)",
      "Bash(python3 .ephor/judge.py check *)",
      "Bash(python3 .ephor/judge.py validate *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(jq *)",
      "Bash(bash .ephor/scripts/*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(glab *)",
      "Bash(gh *)",
      "Bash(podman *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Bash(gcloud *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.ssh/**)",
      "Read(~/.netrc)",
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Edit(.gitlab/**)",
      "Edit(.opencode/**)",
      "Edit(opencode.json)",
      "Edit(.vscode/**)",
      "Edit(.gitlab-ci.yml)",
      "Edit(.pre-commit-config.yaml)",
      "Edit(.gitleaks.toml)",
      "Edit(Makefile)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(.ephor/**)",
      "Edit(tasks/**)",
      "Edit(.git/config)",
      "Edit(.git/hooks/**)",
      "Edit(.git/info/**)",
      "Edit(GNUmakefile)",
      "Edit(makefile)",
      "Edit(.mcp.json)",
      "Edit(CLAUDE.local.md)",
      "Edit(STEER.md)",
      "Bash(rm *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git update-ref *)",
      "Bash(git config *)",
      "Bash(make task-new *)",
      "Bash(make task-check *)",
      "Bash(make adapters *)",
      "Bash(make fetch-docs *)",
      "Bash(make checkpoints-purge *)",
      "Bash(make task-worktree *)",
      "Bash(make task-approve *)",
      "Bash(make task-ranger *)",
      "Bash(make opencode-modeles *)",
      "Bash(python3 .ephor/judge.py approuve *)",
      "Bash(python3 .ephor/judge.py ranger *)",
      "Bash(bash .ephor/scripts/worktree.sh *)",
      "Bash(python3 .ephor/fetch_docs.py *)",
      "Bash(python3 .ephor/judge.py new *)",
      "Bash(python3 .ephor/judge.py rouge *)",
      "WebFetch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": ["~/.cache/uv", "~/.cache/ephor"]
    }
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTEST_ADDOPTS": "-p no:cacheprovider"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.ephor/hooks/avant-outil.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.ephor/hooks/apres-outil.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.ephor/hooks/debut-tour.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.ephor/hooks/fin-tour.sh\"",
            "timeout": 40
          }
        ]
      }
    ]
  }
}
