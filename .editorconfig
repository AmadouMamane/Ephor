root = true
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
[*.{json,yml,yaml,md,sh}]
indent_size = 2

# Les recettes de make exigent des tabulations : un éditeur qui applique « space » les casse.
[Makefile]
indent_style = tab
