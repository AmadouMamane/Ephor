{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "tool_output": {
    "max_lines": 600,
    "max_bytes": 51200
  },
  "permission": {
    "bash": {
      "*": "ask",
      "make *": "allow",
      "uv sync *": "allow",
      "uv run pytest *": "allow",
      "uv run ruff *": "allow",
      "uv run mypy *": "allow",
      "uv run lint-imports *": "allow",
      "uv run mutmut *": "allow",
      "python3 .ephor/judge.py check *": "allow",
      "python3 .ephor/judge.py validate *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git switch *": "allow",
      "git restore *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "jq *": "allow",
      "bash .ephor/scripts/*": "allow",
      "git push *": "ask",
      "glab *": "ask",
      "gh *": "ask",
      "podman *": "ask",
      "docker *": "ask",
      "kubectl *": "ask",
      "gcloud *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "rm *": "deny",
      "git push --force *": "deny",
      "git reset --hard *": "deny",
      "git update-ref *": "deny",
      "git config *": "deny",
      "make task-new *": "deny",
      "make task-check *": "deny",
      "make adapters *": "deny",
      "make fetch-docs *": "deny",
      "make checkpoints-purge *": "deny",
      "make task-worktree *": "deny",
      "make task-approve *": "deny",
      "make opencode-modeles *": "deny",
      "python3 .ephor/judge.py approuve *": "deny",
      "bash .ephor/scripts/worktree.sh *": "deny",
      "python3 .ephor/fetch_docs.py *": "deny",
      "python3 .ephor/judge.py new *": "deny",
      "python3 .ephor/judge.py rouge *": "deny"
    },
    "edit": {
      "*": "allow",
      ".claude/**": "deny",
      ".github/**": "deny",
      ".gitlab/**": "deny",
      ".opencode/**": "deny",
      "opencode.json": "deny",
      ".vscode/**": "deny",
      ".gitlab-ci.yml": "deny",
      ".pre-commit-config.yaml": "deny",
      ".gitleaks.toml": "deny",
      "Makefile": "deny",
      "AGENTS.md": "deny",
      "CLAUDE.md": "deny",
      ".ephor/**": "deny",
      "tasks/**": "deny",
      ".git/config": "deny",
      ".git/hooks/**": "deny",
      ".git/info/**": "deny",
      "GNUmakefile": "deny",
      "makefile": "deny",
      ".mcp.json": "deny",
      "CLAUDE.local.md": "deny",
      "STEER.md": "deny"
    },
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny"
    },
    "external_directory": {
      "~/.aws/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.kube/**": "deny",
      "~/.ssh/**": "deny",
      "~/.netrc": "deny"
    },
    "webfetch": "deny"
  }
}
