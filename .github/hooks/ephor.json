{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "bash .ephor/hooks/kill-switch.sh",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "bash .ephor/hooks/block-secrets.sh",
        "timeout": 15
      },
      {
        "type": "command",
        "command": "bash .ephor/hooks/write-guard.sh",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "bash .ephor/hooks/scope-guard.sh",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "bash .ephor/hooks/refs-guard.sh",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "bash .ephor/hooks/shell-guard.sh",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "bash .ephor/hooks/read-guard.sh",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "bash .ephor/hooks/steer.sh",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash .ephor/hooks/budget.sh",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "bash .ephor/hooks/checkpoint.sh",
        "timeout": 30
      }
    ]
  }
}
