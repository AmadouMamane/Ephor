{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "env EPHOR_OUTIL=copilot bash .ephor/hooks/avant-outil.sh",
        "timeout": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "env EPHOR_OUTIL=copilot bash .ephor/hooks/debut-tour.sh",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "env EPHOR_OUTIL=copilot bash .ephor/hooks/fin-tour.sh",
        "timeout": 40
      }
    ]
  }
}
